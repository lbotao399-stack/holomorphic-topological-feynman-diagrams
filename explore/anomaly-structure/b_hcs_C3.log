   K = (2*p0_0*p1_1*p2_2 + p0_0*p1_1*p3_2 - 2*p0_0*p1_2*p2_1 - p0_0*p1_2*p3_1 - 2*p0_1*p1_0*p2_2 - p0_1*p1_0*p3_2 + 2*p0_1*p1_2*p2_0 + p0_1*p1_2*p3_0 + 2*p0_2*p1_0*p2_1 + p0_2*p1_0*p3_1 - 2*p0_2*p1_1*p2_0 - p0_2*p1_1*p3_0)*(p0_0*p2_1*p3_2 - p0_0*p2_2*p3_1 - p0_1*p2_0*p3_2 + p0_1*p2_2*p3_0 + p0_2*p2_0*p3_1 - p0_2*p2_1*p3_0 + p1_0*p2_1*p3_2 - p1_0*p2_2*p3_1 - p1_1*p2_0*p3_2 + p1_1*p2_2*p3_0 + p1_2*p2_0*p3_1 - p1_2*p2_1*p3_0)/288
   mod conservation: K = 0 ;  K / Delta^2 = 0
