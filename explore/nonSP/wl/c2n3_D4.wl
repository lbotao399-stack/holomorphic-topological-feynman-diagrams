ys = {-rC*(-gA*(1 - rA)*(-gB - s1x1 + 1) + gB*(1 - rB)*(-gA + s1x1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + s1x1 - 1, -rC*(gA*gB*(1 - rA) - gA*gB*(1 - rB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), gB + (1 - rA)*(-gB*(1 - rB)*(gA + gB - 1) + (1 - rC)*(-gA - gB + 1)*(-gB - s1x1 + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + (1 - rC)*(gA*(1 - rA)*(-gB - s1x1 + 1) - gB*(1 - rB)*(-gA + s1x1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), gB + (1 - rA)*(-gB*(1 - rB)*(gA + gB) - gB*(1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + (1 - rC)*(-gA*gB*(1 - rA) + gA*gB*(1 - rB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), -gA - gB + (1 - rA)*(gB*(1 - rB)*(gA + gB - 1) - (1 - rC)*(-gA - gB + 1)*(-gB - s1x1 + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + (1 - rB)*(gA*(1 - rA)*(gA + gB - 1) - (1 - rC)*(-gA + s1x1)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + 1, -gA - gB + (1 - rA)*(gB*(1 - rB)*(gA + gB) + gB*(1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + (1 - rB)*(gA*(1 - rA)*(gA + gB) + gA*(1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + 1};
