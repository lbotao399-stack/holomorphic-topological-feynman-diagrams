ys = {f1x13*rC*(gA*gB*(1 - rB) - gA*(1 - rA)*(SA + gB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - f1x35*rA*(-gB*(1 - rB)*(-SA - gA - gB) + (1 - rC)*(SA + gB)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), f1x13*rC*(-SB*gA*(1 - rA) + gB*(1 - rB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - f1x35*rA*(SB*(1 - rC)*(-gA - gB + 1) - gB*(1 - rB)*(-SB - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), f1x15*rB*(-gA*(1 - rA)*(-SA - gA - gB) + gA*(1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + f1x35*rA*(-gB*(1 - rB)*(-SA - gA - gB) + (1 - rC)*(SA + gB)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), f1x15*rB*(-gA*(1 - rA)*(-SB - 1) + (1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + f1x35*rA*(SB*(1 - rC)*(-gA - gB + 1) - gB*(1 - rB)*(-SB - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(1 - f1x35)*(-gB*(1 - rB)*(-SA - gA - gB) + (1 - rC)*(SA + gB)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - rC*(1 - f1x13)*(gA*gB*(1 - rB) - gA*(1 - rA)*(SA + gB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(1 - f1x35)*(SB*(1 - rC)*(-gA - gB + 1) - gB*(1 - rB)*(-SB - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - rC*(1 - f1x13)*(-SB*gA*(1 - rA) + gB*(1 - rB))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(1 - f1x35)*(-gB*(1 - rB)*(-SA - gA - gB) + (1 - rC)*(SA + gB)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + rB*(1 - f1x15)*(-gA*(1 - rA)*(-SA - gA - gB) + gA*(1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(1 - f1x35)*(SB*(1 - rC)*(-gA - gB + 1) - gB*(1 - rB)*(-SB - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) + rB*(1 - f1x15)*(-gA*(1 - rA)*(-SB - 1) + (1 - rC)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1))};
