Print["gsym1 ", InputForm[(detB/Qp^7) /. {s1x1 -> 7/97, gA -> 21/97, gB -> 15/97, rA -> 48/97, rB -> 61/97, rC -> 32/97}]];
Print["gsym2 ", InputForm[(detB/Qp^7) /. {s1x1 -> 49/97, gA -> 70/97, gB -> 14/97, rA -> 74/97, rB -> 32/97, rC -> 2/97}]];
