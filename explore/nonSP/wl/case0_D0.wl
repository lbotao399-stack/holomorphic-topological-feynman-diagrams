ys = {rB*(-gA*(1 - rA)*(-s2x1 + s2x2)*(-gA - gB + 1) + gA*(1 - rC)*(-s2x1 + s2x2)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rB*(-gA*(1 - rA)*(-s2x1*(-gA - gB + 1) - s3x1 + 1) + (1 - rC)*(-gA*s2x1 + s3x1)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - s3x1, rB*(-gA*(1 - rA)*(-s2x1*(-gA - gB + 1) - s3x2 + 1) + (1 - rC)*(-gA*s2x1 + s3x2)*(-gA - gB + 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)) - s3x2, rC*(gA*gB*(1 - rB)*(-s2x1 + s2x2) - gA*(1 - rA)*(gB*(-s2x1 + s2x2) + s2x1 - s2x2))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rC*(-gA*(1 - rA)*(-gB*s2x1 + s2x1 - 1) + gB*(1 - rB)*(-gA*s2x1 + s3x1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rC*(-gA*(1 - rA)*(-gB*s2x1 + s2x1 - 1) + gB*(1 - rB)*(-gA*s2x1 + s3x2))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(-gB*(1 - rB)*(-s2x1 + s2x2)*(-gA - gB + 1) + (1 - rC)*(-gA - gB + 1)*(gB*(-s2x1 + s2x2) + s2x1 - s2x2))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(-gB*(1 - rB)*(-s2x1*(-gA - gB + 1) - s3x1 + 1) + (1 - rC)*(-gA - gB + 1)*(-gB*s2x1 + s2x1 - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1)), rA*(-gB*(1 - rB)*(-s2x1*(-gA - gB + 1) - s3x2 + 1) + (1 - rC)*(-gA - gB + 1)*(-gB*s2x1 + s2x1 - 1))/(gA*(1 - rA) + gB*(1 - rB) + (1 - rC)*(-gA - gB + 1))};
