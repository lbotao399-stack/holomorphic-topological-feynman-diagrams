If[Union[Denominator /@ Ns] =!= {1}, Print["NOT POLYNOMIAL"]; Exit[1]];
Ns = Expand[Ns];
bord = Prepend[Table[Prepend[D[Ns[[j]], #] & /@ vars, Ns[[j]]], {j, 9}], Prepend[D[Qp, #] & /@ vars, Qp]];
