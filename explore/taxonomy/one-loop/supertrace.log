=== formal S_H (k = H+1; Tr_X := Tr_X x^k; Tr_{R*} = (-1)^k Tr_R; Tr_coadj = (-1)^k Tr_adj)
  2d N=(2,2), chirals R                            S_1 = 0
  2d N=(0,2) [ESW (2,0)], chirals R, Fermis F      S_1 = -1 Tr_adj + 1 Tr_R + -1 Tr_F
  2d N=(4,0), hypers U                             S_1 = -2 Tr_adj + 1 Tr_U
  2d N=(4,4), hypers U                             S_1 = 0
  2d N=(8,8)                                       S_1 = 0
  2d N=(N+,0), N+ = 2..7                           S_1 = -1 Tr_adj + -1/2 Tr_adj*(N+-2)
  4d N=1, chirals R                                S_2 = -1 Tr_adj + 1 Tr_R
  4d N=2, hypers U                                 S_2 = 1 Tr_U
  4d N=4                                           S_2 = 0
  6d N=(1,0), hypers U, form U//g                  S_3 = -1 Tr_adj + 1/2 Tr_U
